/* FIXME: remove 'delete-node' if building with Zephyr version 4 or later
   when ST removed storage_partition from their SDK board DTS.  */
/delete-node/ &storage_partition;

&flash0 {
  partitions {
    /* Set 48KB (3 * 16K) of storage at the beginning of bank2
     * in order to have at least 2 sectors each smaller than 32K
     * (nvs.h: uint16_t sector_size) and total less than 64K-1.
     */
    storage_partition: partition@100000 {
      label = "storage";
      reg = <0x000100000 DT_SIZE_K(48)>;
    };
  };
};

&arduino_serial {
    status = "okay";

    modbus0 {
        compatible = "zephyr,modbus-serial";
        status = "okay";

        de-gpios = <&arduino_header 8 GPIO_ACTIVE_LOW>; /* D2*/
    };
};
