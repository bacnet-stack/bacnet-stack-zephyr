/* FIXME: remove 'delete-node' if building with Zephyr version 4 or later
   when ST removed storage_partition from their SDK board DTS.  */
/delete-node/ &storage_partition;

/ {
  leds {
    status = "disabled";
  };

  pwmleds {
    compatible = "pwm-leds";
    green_pwm_led: green_pwm_led {
      pwms = <&pwm3 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };
  };
  aliases {
    pwm-led0 = &green_pwm_led;
  };
};

&timers3 {
    status = "okay";
    st,prescaler = <64>;
    /* User LD1 GREEN */
    pwm3: pwm {
        status = "okay";
        pinctrl-0 = <&tim3_ch3_pb0>;
        pinctrl-names = "default";
    };
};

&flash0 {
  partitions {
    /*
     * nvs subsystem requires 2 sectors with a max total of 32K
     * On F4 series, the only option is to use the following
     * partition, which is compatible with mcuboot usage.
     * (limited by nvs.h: uint16_t sector_size)
     * Located in the first two 16K sectors of the second flash bank
     * (0x100000), above the firmware image which is linked at 0x0 when
     * not using mcuboot. A storage partition overlapping the firmware
     * would make the settings init fail (-EDEADLK) and erasing it would
     * erase the running firmware.
     */
    storage_partition: partition@100000 {
      compatible = "zephyr,mapped-partition";
      label = "storage";
      reg = <0x0100000 DT_SIZE_K(32)>;
    };
  };
};
