menuconfig BACNET_DATALINK_SETTINGS
    bool "BACNET_DATALINK_SETTINGS"
    default y if BACNETSTACK
    help
      This option enable BACnet Datalink Settings

if BACNET_DATALINK_SETTINGS

    config BZLL_NODE_TIME_TO_LIVE_S
        int "BZLL time to live node in the VMAC table"
        default 600
        help
           BZLL interval to keep a node in the VMAC table before an update

    config BZLL_SCAN_NODES_INTERVAL_S
        int "BZLL interval to scan the zigbee network for BACnet nodes to update the VMAC table"
        default 3600
        help
           BZLL interval to scan the zigbee network for BACnet nodes to update the VMAC table

endif # BACNET_DATALINK_SETTINGS