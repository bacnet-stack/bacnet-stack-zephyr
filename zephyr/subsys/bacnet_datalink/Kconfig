config BZLL_RECEIVE_PACKET_COUNT
    int "BZLL receive packet count"
    range 1 256
    default 2
    help
      Number of packets in the BZLL receive queue. This value must be a
      power of 2.

config BZLL_NODE_TIME_TO_LIVE_S
    int "BZLL node time-to-live in the VMAC table"
    default 600
    help
       Time in seconds to keep a node in the VMAC table before it must be updated.

config BZLL_SCAN_NODES_INTERVAL_S
    int "BZLL interval for scanning the Zigbee network for BACnet nodes and updating the VMAC table"
    default 3600
    help
       Time interval in seconds between scans of the Zigbee network for BACnet nodes to update the VMAC table.

config DLMSTP_MAX_INFO_FRAMES
    int "Maximum number of MS/TP information frames queued"
    range 1 128
    default 1
    depends on BACDL_MSTP
    help
      Maximum number of received MS/TP information frames buffered for
      the application.
